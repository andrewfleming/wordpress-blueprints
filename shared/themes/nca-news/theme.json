{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "648px",
			"wideSize": "1248px"
		},
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "primary", "color": "#1691db", "name": "Primary" },
				{ "slug": "background", "color": "#ffffff", "name": "Background" },
				{ "slug": "text", "color": "#202223", "name": "Text" },
				{ "slug": "ink-soft", "color": "#404446", "name": "Ink Soft" },
				{ "slug": "muted", "color": "#606669", "name": "Muted" },
				{ "slug": "subtle", "color": "#81888c", "name": "Subtle" },
				{ "slug": "rule", "color": "#e0e1e2", "name": "Rule" },
				{ "slug": "surface", "color": "#eaebec", "name": "Surface" },
				{ "slug": "surface-soft", "color": "#f5f5f5", "name": "Surface Soft" },
				{ "slug": "breaking", "color": "#c90000", "name": "Breaking" },
				{ "slug": "opinion", "color": "#0059bf", "name": "Opinion" },
				{ "slug": "entertainment", "color": "#d51387", "name": "Entertainment" },
				{ "slug": "sport", "color": "#4aa90f", "name": "Sport" },
				{ "slug": "lifestyle", "color": "#00838d", "name": "Lifestyle" },
				{ "slug": "technology", "color": "#f46a00", "name": "Technology" },
				{ "slug": "checkout", "color": "#7c28b6", "name": "Checkout" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "source-serif-4",
					"name": "Source Serif 4 (headlines)",
					"fontFamily": "\"Source Serif 4\", \"Times New Roman\", Times, serif",
					"fontFace": [
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/source-serif-4/source-serif-4-700-latin-ext.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/source-serif-4/source-serif-4-700-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "helvetica-neue",
					"name": "Helvetica Neue (system)",
					"fontFamily": "\"Helvetica Neue\", HelveticaNeue, Helvetica, Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "label", "size": "12px", "name": "Label" },
				{ "slug": "small", "size": "14px", "name": "Small" },
				{ "slug": "body", "size": "16px", "name": "Body" },
				{ "slug": "title", "size": "18px", "name": "Title" },
				{ "slug": "long-form", "size": "18px", "name": "Long Form" },
				{ "slug": "card", "size": "24px", "name": "Card" },
				{ "slug": "headline", "size": "32px", "name": "Headline" },
				{ "slug": "display", "size": "40px", "name": "Display" }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "xs", "size": "4px", "name": "Extra small" },
				{ "slug": "sm", "size": "8px", "name": "Small" },
				{ "slug": "md", "size": "16px", "name": "Medium" },
				{ "slug": "lg", "size": "24px", "name": "Large" },
				{ "slug": "xl", "size": "32px", "name": "Extra large" },
				{ "slug": "xxl", "size": "48px", "name": "XXL" }
			]
		},
		"custom": {
			"rounded": { "none": "0px", "sm": "2px", "md": "4px" }
		}
	},
	"styles": {
		"spacing": {
			"blockGap": "16px",
			"padding": {
				"top": "0px",
				"right": "clamp(1rem, 3vw, 1.5rem)",
				"bottom": "0px",
				"left": "clamp(1rem, 3vw, 1.5rem)"
			}
		},
		"color": {
			"background": "var:preset|color|background",
			"text": "var:preset|color|text"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|helvetica-neue",
			"fontSize": "var:preset|font-size|body",
			"fontWeight": "400",
			"lineHeight": "1.4"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|source-serif-4",
					"fontWeight": "700",
					"lineHeight": "1.25"
				},
				"color": { "text": "var:preset|color|text" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|display", "lineHeight": "1.2", "letterSpacing": "-0.01em" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|card" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|title" } },
			"link": {
				"color": { "text": "var:preset|color|text" },
				"typography": { "textDecoration": "none" },
				":hover": {
					"color": { "text": "var:preset|color|primary" },
					"typography": { "textDecoration": "underline" }
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|background"
				},
				"border": { "radius": "0px", "width": "1px", "style": "solid", "color": "var:preset|color|primary" },
				"spacing": {
					"padding": { "top": "8px", "right": "16px", "bottom": "8px", "left": "16px" }
				},
				"typography": {
					"fontFamily": "var:preset|font-family|helvetica-neue",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "400",
					"lineHeight": "1.15"
				},
				":hover": {
					"typography": { "textDecoration": "underline" }
				}
			}
		},
		"blocks": {
			"core/post-title": {
				"typography": { "fontFamily": "var:preset|font-family|source-serif-4", "fontWeight": "700", "lineHeight": "1.3" }
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|subtle" },
				"typography": { "fontSize": "var:preset|font-size|label" }
			},
			"core/post-excerpt": {
				"color": { "text": "var:preset|color|ink-soft" },
				"typography": { "fontSize": "var:preset|font-size|small", "lineHeight": "1.4" }
			},
			"core/post-terms": {
				"typography": { "fontSize": "var:preset|font-size|label", "fontWeight": "700" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|rule" }
			},
			"core/quote": {
				"border": { "left": { "color": "var:preset|color|primary", "width": "4px", "style": "solid" } },
				"spacing": { "padding": { "left": "24px" } },
				"typography": { "fontFamily": "var:preset|font-family|source-serif-4", "fontSize": "var:preset|font-size|card", "fontWeight": "700", "lineHeight": "1.3" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "sidebar", "title": "Trending sidebar", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Page (no title)", "postTypes": [ "page" ] }
	]
}
